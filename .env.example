# Identify yourself to government servers; some block anonymous clients.
USER_AGENT="DisasterDeclarationWatch/0.1 (ops@yourdomain.org)"

# Where the SQLite state lives. Must persist across restarts or you'll re-baseline.
DATA_DIR=./data
PORT=8787

# Optional: only alert for these states (events with no detectable state still alert).
# WATCH_STATES=TX,LA,FL

# Which statuses alert on webhooks/Slack: declared, amended, requested
ALERT_STATUSES=declared,amended,requested

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Comma-separated JSON webhooks (Zapier, Make, n8n, your own API). Receives the full alert payload.
WEBHOOK_URLS=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=
# official = only text when a government source is involved; all = include press reports; none = off
SMS_TIER=official
SMS_STATUSES=declared

# End-of-day email digest: YES/NO for new declarations plus which endpoints posted anything new.
# MAIL_PROVIDER=gmail sends through the Gmail API: set the OAuth client below, then run
# `node src/index.ts --gmail-auth` once to store GMAIL_REFRESH_TOKEN. The client must allow
# the redirect URI http://127.0.0.1:8765/oauth/callback.
MAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# MAIL_PROVIDER=smtp works with any SMTP provider (Gmail app password, Amazon SES, Resend, Postmark, SendGrid).
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=
DIGEST_CC=
# Defaults to SMTP_USER
DIGEST_FROM=
# 24-hour local time and IANA time zone for the daily send
DIGEST_TIME=15:00
DIGEST_TZ=America/New_York

# Chamber status portal. The token is the daily disaster watch bearer from the portal's .ingest-tokens file.
STATUS_PORTAL_URL=https://usccfruntimemonitor.vercel.app
STATUS_INGEST_TOKEN=
