{
  "name": "disaster-declaration-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Watches FEMA, the White House, the Federal Register, governors, and local news for new disaster and emergency declarations and alerts within seconds of publication.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "once": "node src/index.ts --once",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.0",
    "node-html-parser": "^9.0.4",
    "nodemailer": "^10.0.13",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.0"
  }
}
